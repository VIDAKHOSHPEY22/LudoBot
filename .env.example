# ============================================
# Ludo Bot - Quick Setup
# ============================================

# Required: Get these from @BotFather and @userinfobot
BOT_TOKEN=your_bot_token_here
OWNER_ID=your_telegram_user_id

# Database (SQLite is fine for testing)
DATABASE_URL=sqlite:///ludo.db

# Redis (comment out if not using)
REDIS_URL=redis://localhost:6379

# Security (change this!)
SECRET_KEY=your_secret_key_here

# Game settings (optional)
MAX_PLAYERS=4
MIN_PLAYERS=2
TURN_TIMEOUT=60
WAITING_TIMEOUT=120
